#!/bin/sh
# Runs one of the plugin's programs for this machine: the build it ships, else one built here
# with `cargo install`. A hook must never fail the agent, so with none it answers "no change".
name=$1
shift
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "$(uname -s)-$(uname -m)" in
  MINGW* | MSYS* | CYGWIN*) folder=windows-x64 ext=.exe ;;
  Linux-x86_64) folder=linux-x64 ext= ;;
  Linux-aarch64) folder=linux-arm64 ext= ;;
  Darwin-arm64) folder=macos-arm64 ext= ;;
  Darwin-x86_64) folder=macos-x64 ext= ;;
  *) folder=unknown ext= ;;
esac
for program in "$root/bin/$folder/$name$ext" "$HOME/.cargo/bin/$name$ext"; do
  [ -x "$program" ] && exec "$program" "$@"
done
command -v "$name" >/dev/null 2>&1 && exec "$name" "$@"
[ -n "${DAM_RUN_OR_FAIL:-}" ] && exit 127
while IFS= read -r _line; do :; done
echo '{}'
