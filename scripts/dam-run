#!/bin/sh
# Runs the dam's one program, `dam`, for this machine: the build it ships, else one built here
# with `cargo install`. A hook must never fail the agent, so with none it answers "no change".
# On Windows it starts nothing but the program: each process costs tens of milliseconds under Git
# Bash, and Claude Code cancels a session-end hook that is not done quickly.
self=$0
case $self in */*|*\\*) ;; *) self=$(command -v -- "$self") || self=$0 ;; esac
case $self in */*|*\\*) dir=${self%[/\\]*} ;; *) dir=. ;; esac
if [ "${OS:-}" = Windows_NT ]; then
  folder=windows-x64 ext=.exe
else
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) folder=linux-x64 ext= ;;
    Linux-aarch64) folder=linux-arm64 ext= ;;
    Darwin-arm64) folder=macos-arm64 ext= ;;
    Darwin-x86_64) folder=macos-x64 ext= ;;
    *) folder=unknown ext= ;;
  esac
fi
for program in "$dir/../bin/$folder/dam$ext" "$HOME/.cargo/bin/dam$ext"; do
  [ -x "$program" ] && exec "$program" "$@"
done
command -v dam >/dev/null 2>&1 && exec dam "$@"
[ -n "${DAM_RUN_OR_FAIL:-}" ] && exit 127
while IFS= read -r _line; do :; done
echo '{}'
